NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_career_studio
JWT_ACCESS_SECRET=replace_with_long_random_value
JWT_REFRESH_SECRET=replace_with_different_long_random_value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
LOG_LEVEL=info
API_PREFIX=/api/v1
